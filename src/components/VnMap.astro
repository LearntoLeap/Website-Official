---
// Ranh giới 34 tỉnh/thành sau sáp nhập 2025: Free-GIS-Data (github.com/nguyenduy1133/Free-GIS-Data). Chấm Hoàng Sa, Trường Sa: Natural Earth (góc nhìn Việt Nam).
import VN from '../data/vn-map.json';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; eyebrow: string; title: string; provinces: string[]; more: string }
const { lang, eyebrow, title, provinces, more } = Astro.props;

/**
 * Toạ độ từng tỉnh — CÙNG THỨ TỰ với impact.map.provinces trong vi.ts / en.ts.
 * [kinh độ, vĩ độ, miền (b/t/n), phía đặt nhãn (l/r), độ cao nhãn trong khung bản đồ]. Thêm tỉnh thì thêm một dòng.
 */
const COORDS: [number, number, 'b' | 't' | 'n', 'l' | 'r', number][] = [
  [105.85, 21.03, 'b', 'l', 150], // Hà Nội (trụ sở)
  [106.70, 10.78, 'n', 'l', 715], // TP. Hồ Chí Minh
  [106.08, 21.19, 'b', 'r', 95], // Bắc Ninh
  [105.69, 18.67, 't', 'l', 345], // Nghệ An
  [105.85, 21.59, 'b', 'l', 20], // Thái Nguyên
  [106.68, 20.86, 'b', 'r', 225], // Hải Phòng
  [105.78, 19.81, 't', 'l', 280], // Thanh Hóa
  [105.91, 18.34, 't', 'r', 330], // Hà Tĩnh
  [106.89, 11.54, 'n', 'l', 640], // Đồng Nai (Đồng Xoài, Bình Phước cũ)
  [105.78, 10.03, 'n', 'l', 865], // Cần Thơ
  [105.63, 10.46, 'n', 'l', 790], // Đồng Tháp
  [107.08, 20.95, 'b', 'r', 160], // Quảng Ninh
  [103.91, 21.33, 'b', 'l', 85], // Sơn La
  [106.76, 21.85, 'b', 'r', 30], // Lạng Sơn
  [105.97, 20.25, 'b', 'l', 215], // Ninh Bình
];
const REGION = lang === 'vi' ? { b: 'Miền Bắc', t: 'Miền Trung', n: 'Miền Nam', hq: 'Trụ sở chính' } : { b: 'North', t: 'Central', n: 'South', hq: 'Headquarters' };
const isl = lang === 'vi' ? ['QĐ. Hoàng Sa', 'QĐ. Trường Sa'] : ['Hoang Sa Archipelago', 'Truong Sa Archipelago'];
const islOf = lang === 'vi' ? ['TP. Đà Nẵng', 'Tỉnh Khánh Hòa'] : ['Da Nang City', 'Khanh Hoa Province'];
const [hs, ts] = [VN.arch.hs, VN.arch.ts];

// Cùng phép chiếu với file tạo src/data/vn-map.json.
const K = Math.cos((16 * Math.PI) / 180);
const VB = [-330, -10, 1280, 1010];
const LX = { l: -40, r: 380 };
const pct = (x: number, y: number) => `left:${(((x - VB[0]) / VB[2]) * 100).toFixed(2)}%;top:${(((y - VB[1]) / VB[3]) * 100).toFixed(2)}%`;
const pins = provinces.flatMap((name, i) => {
  const c = COORDS[i];
  if (!c) return [];
  const [lon, lat, reg, side, ly] = c;
  return [{ name, i, x: (lon - 102) * K * 60, y: (23.6 - lat) * 60, tag: i === 0 ? REGION.hq : REGION[reg], side, lx: LX[side], ly }];
});
const PIN = 'M0,0C-3,-9 -13,-15 -13,-25A13,13 0 1 1 13,-25C13,-15 3,-9 0,0Z';
---
<div class="vnm reveal">
  <div class="vnm-head">
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
  </div>
  <div class="vnm-stage">
    <svg class="vnm-svg" viewBox={VB.join(' ')} role="img" aria-label={`${title}: ${provinces.join(', ')}. ${isl.map((x, k) => `${x} (${islOf[k]})`).join(', ')}.`}>
      <defs><g id="vnm-p">{VN.provinces.map((d) => <path d={d} />)}</g></defs>
      <use href="#vnm-p" class="depth" />
      <use href="#vnm-p" class="land" />
      <g class="coast">{VN.coast.map(([x, y]) => <circle cx={x} cy={y} r="1.6" />)}</g>
      {[hs, ts].map((g, k) => {
        const [x1, y1, x2, y2] = g.box;
        return (
          <g class="arch">
            <rect x={x1 - 22} y={y1 - 22} width={x2 - x1 + 44} height={y2 - y1 + 44} rx="28" />
            {g.dots.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
            <text x={k ? x2 + 22 : (x1 + x2) / 2} y={k ? y1 - 52 : y2 + 56} text-anchor={k ? 'end' : 'middle'}>{isl[k]}</text>
            <text class="of" x={k ? x2 + 22 : (x1 + x2) / 2} y={k ? y1 - 32 : y2 + 76} text-anchor={k ? 'end' : 'middle'}>{islOf[k]}</text>
          </g>
        );
      })}
      <g class="leads">
        {pins.map((p) => <><path d={`M${p.x.toFixed(0)},${p.y.toFixed(0)}L${p.side === 'l' ? p.lx + 14 : p.lx - 14},${p.ly}`} /><circle cx={p.side === 'l' ? p.lx + 14 : p.lx - 14} cy={p.ly} r="3.5" /></>)}
      </g>
      {pins.map((p) => (
        <g class:list={['pin', { hq: p.i === 0 }]} style={`--i:${p.i}`} transform={`translate(${p.x.toFixed(1)},${p.y.toFixed(1)})${p.i === 0 ? ' scale(1.35)' : ''}`}>
          <g class="drop"><path d={PIN} /><circle cy="-25" r="5" /></g>
        </g>
      ))}
    </svg>
    {pins.map((p) => (
      <span class:list={['vnm-lb', p.side, { hq: p.i === 0 }]} style={pct(p.lx, p.ly)} aria-hidden="true"><small>{p.tag}</small><b>{p.name}</b></span>
    ))}
  </div>
  <ul class="prov-cloud">
    {provinces.map((p) => <li class="prov"><span class="d"></span>{p}</li>)}
    <li class="prov more"><span class="d"></span>{more}</li>
  </ul>
</div>
