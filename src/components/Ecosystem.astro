---
// Hệ sinh thái giải pháp: danh sách 6 mảng (tab dọc) + khung minh hoạ robot/thiết bị của mảng đang chọn.
// Không ghi tên sản phẩm; ảnh chỉ để minh hoạ. Điều khiển tab ở scripts/site.ts ([data-eco]).
import SectionHead from './SectionHead.astro';
import Btn from './Btn.astro';
import Icon from './Icon.astro';
import { bot } from '../data/site';
import { useT } from '../i18n';
import { href, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const e = useT(lang).home.eco;
// Ảnh minh hoạ từng mảng (cùng thứ tự với i18n home.eco.items): cx tâm ngang %, b cách đáy %, h/w cao/rộng %.
type Shot = { src: string; cx: number; b: number; h?: number; w?: number; r?: number };
const SHOTS: Shot[][] = [
  [{ src: 'ugot-dog', cx: 68, b: 32, w: 38 }, { src: 'yanshee', cx: 34, b: 32, h: 54 }],
  [{ src: 'kt-screen', cx: 52, b: 44, w: 54 }, { src: 'kt-3dprinter', cx: 84, b: 32, h: 30 }, { src: 'vr-quest', cx: 21, b: 32, w: 24 }],
  [{ src: 'kt-smarthouse', cx: 68, b: 32, w: 42 }, { src: 'cruzr', cx: 32, b: 32, h: 54 }],
  [{ src: 'am-jump', cx: 76, b: 32, h: 46 }, { src: 'stickem-robot', cx: 38, b: 32, w: 46 }],
  [{ src: 'ukit-transformer', cx: 72, b: 32, h: 50 }, { src: 'ugot-up', cx: 34, b: 32, w: 38 }],
  [{ src: 'ebd-stem5', cx: 27, b: 38, w: 19, r: -9 }, { src: 'ebd-stem10', cx: 43, b: 40, w: 19, r: 4 }, { src: 'weeemake-kit', cx: 72, b: 32, w: 30 }],
];
const style = (s: Shot, j: number) =>
  [`--cx:${s.cx}%`, `--b:${s.b}%`, s.h ? `--h:${s.h}%` : `--w:${s.w}%`, `--r:${s.r ?? 0}deg`, `--d:${j}`].join(';');
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="sp eco" data-buddy="jump" aria-labelledby="eco-title">
  <div class="wrap eco-wrap" data-eco>
    <div class="eco-side">
      <SectionHead eyebrow={e.eyebrow} title={e.title} center={false} id="eco-title" />
      <div class="eco-list reveal d1" role="tablist" aria-orientation="vertical" aria-label={e.listLabel}>
        {e.items.map((it, i) => (
          <button type="button" role="tab" class:list={{ on: i === 0 }} id={`eco-tab-${i}`} aria-controls={`eco-pane-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}>
            <span class="n">{pad(i + 1)}</span><span class="t">{it.title}</span><Icon name="arrow" class="ar" />
          </button>
        ))}
      </div>
    </div>
    <div class="eco-panel reveal d2">
      <div class="eco-deco" aria-hidden="true"></div>
      {e.items.map((it, i) => (
        <div class:list={['eco-pane', { on: i === 0 }]} role="tabpanel" id={`eco-pane-${i}`} aria-labelledby={`eco-tab-${i}`} hidden={i !== 0}>
          <div class="eco-shots" aria-hidden="true">
            {SHOTS[i].map((s, j) => <img src={bot(s.src)} alt="" style={style(s, j)} loading="lazy" decoding="async" />)}
          </div>
          <div class="eco-info">
            <span class="k">{pad(i + 1)} / {pad(e.items.length)}</span>
            <h3>{it.title}</h3>
            <p>{it.desc}</p>
            <ul>{it.chips.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
      ))}
      <div class="eco-more"><Btn href={href('solutions', lang)} variant="glass" arrow>{e.cta}</Btn></div>
    </div>
  </div>
</section>
