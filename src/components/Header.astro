---
import Icon from './Icon.astro';
import { useT } from '../i18n';
import { ROUTES, href, withBase, type Lang, type PageKey } from '../i18n/routes';
interface Props { lang: Lang; page: PageKey | null; paths?: Record<Lang, string> }
const { lang, page, paths } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'vi' ? 'en' : 'vi';
const switchHref = withBase(paths ? paths[other] : page ? ROUTES[page][other] : ROUTES.home[other]);
const main: PageKey[] = ['about', 'solutions', 'impact', 'partnership', 'news'];
const all: PageKey[] = ['home', ...main, 'contact'];
const cur = (k: PageKey) => (k === page ? 'page' : undefined);
---
<header class="site" id="hdr">
  <div class="wrap nav">
    <a class="logo" href={href('home', lang)} aria-label="Learn to Leap">
      <img class="logo-img logo-img--light" src={withBase('/images/logo-light.png')} alt="Learn to Leap" width="242" height="96" />
      <img class="logo-img logo-img--dark" src={withBase('/images/logo-dark.png')} alt="" width="242" height="96" />
    </a>
    <nav aria-label={lang === 'vi' ? 'Điều hướng chính' : 'Main navigation'}>
      <ul class="nav-links">
        {main.map((k) => <li><a href={href(k, lang)} aria-current={cur(k)}>{t.common.nav[k]}</a></li>)}
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="tool" href={switchHref} hreflang={other} lang={other} aria-label={t.common.switchLangLabel} title={t.common.switchLangLabel} data-lang-switch>{lang === 'vi' ? 'EN' : 'VI'}</a>
      <button class="tool" type="button" id="themeBtn" aria-label={t.common.themeToDark}
        data-label-light={t.common.themeToLight} data-label-dark={t.common.themeToDark}>
        <Icon name="moon" class="i-moon" /><Icon name="sun" class="i-sun" />
      </button>
      <a class="btn" href={href('contact', lang)}>{t.common.ctaPartner}<Icon name="arrow" stroke={2.4} /></a>
      <button class="burger" id="burger" type="button" aria-label={t.common.menuOpen} aria-expanded="false" aria-controls="mob"
        data-label-open={t.common.menuOpen} data-label-close={t.common.menuClose}><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<div class="mob" id="mob">
  <ul>
    {all.map((k) => <li><a href={href(k, lang)} aria-current={cur(k)}>{t.common.nav[k]}</a></li>)}
  </ul>
  <a class="btn" href={href('contact', lang)}>{t.common.ctaPartner}</a>
</div>
