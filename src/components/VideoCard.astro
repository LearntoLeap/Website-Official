---
import Icon from './Icon.astro';
import { titleOf, ytId, ytThumb, type MediaItem } from '../data/media';
import type { Lang } from '../i18n/routes';
interface Props { item: MediaItem; lang: Lang; index: number; playLabel: string }
const { item, lang, index, playLabel } = Astro.props;
const title = titleOf(item, lang);
---
<button class:list={['vcard reveal', `d${(index % 3) + 1}`]} type="button" data-yt={ytId(item.url)} data-title={title} aria-label={`${playLabel}: ${title}`}>
  <div class="vthumb">
    <img src={ytThumb(item.url)} alt="" loading="lazy" decoding="async" />
    <div class="vplay"><span><Icon name="play" /></span></div>
  </div>
  <div class="vbd">
    <h3>{title}</h3>
    {item.source && <div class="vsrc">{item.source}</div>}
  </div>
</button>
