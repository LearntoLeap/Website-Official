---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HexBg from '../components/HexBg.astro';
import Btn from '../components/Btn.astro';
import Stats from '../components/Stats.astro';
import SectionHead from '../components/SectionHead.astro';
import SolCard from '../components/SolCard.astro';
import NewsCard from '../components/NewsCard.astro';
import CtaBand from '../components/CtaBand.astro';
import LogoStrip from '../components/LogoStrip.astro';
import InlineVideo from '../components/InlineVideo.astro';
import ShortsRail from '../components/ShortsRail.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Peek from '../components/Peek.astro';
import { useT, rich } from '../i18n';
import { href, withBase, type Lang } from '../i18n/routes';
import { SITE } from '../data/site';
import { press, featuredVideo, shorts } from '../data/media';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const h = t.home;
// Sân khấu hero: 5 dòng sản phẩm (thứ tự theo i18n home.hero.lines; không ghi tên hãng).
// Mỗi ảnh: cx = tâm theo chiều ngang (%), b = cách đáy (%), h hoặc w = cao/rộng (%),
// dz = độ trôi khi rê chuột, r = góc xoay. Ảnh đã tách nền nằm ở public/images/robots.
type Shot = { src: string; cx: number; b: number; h?: number; w?: number; dz?: number; r?: number };
const STAGE: { thumb: string; shots: Shot[] }[] = [
  { thumb: 'tienkung', shots: [{ src: 'tienkung', cx: 40, b: -4, h: 106, dz: 10 }] },
  { thumb: 'yanshee', shots: [
    { src: 'ukit-se', cx: 70, b: 4, w: 50, dz: 6 },
    { src: 'yanshee', cx: 34, b: 4, h: 84, dz: 14 },
  ] },
  { thumb: 'ugot-up', shots: [
    { src: 'ukit-transformer', cx: 81, b: 4, h: 56, dz: 6 },
    { src: 'ugot-dog', cx: 37, b: 4, w: 46, dz: 14 },
    { src: 'ugot-up', cx: 62, b: 0, w: 22, dz: 20 },
  ] },
  { thumb: 'stickem-robot', shots: [
    { src: 'weeemake-house', cx: 81, b: 6, h: 52, dz: 6 },
    { src: 'stickem-robot', cx: 35, b: 4, w: 50, dz: 14 },
    { src: 'weeemake-kit', cx: 61, b: 0, w: 24, dz: 20 },
  ] },
  { thumb: 'kt-smarthouse', shots: [
    { src: 'ebd-stem5', cx: 12, b: 40, w: 16, dz: 4, r: -12 },
    { src: 'ebd-stem8', cx: 22, b: 43, w: 16, dz: 6, r: -3 },
    { src: 'kt-wind', cx: 85, b: 6, h: 56, dz: 8 },
    { src: 'kt-smarthouse', cx: 46, b: 3, w: 54, dz: 14 },
  ] },
];
const bot = (n: string) => withBase(`/images/robots/${n}.webp`);
const shotStyle = (s: Shot, i: number) =>
  [`--cx:${s.cx}%`, `--b:${s.b}%`, s.h ? `--h:${s.h}%` : `--w:${s.w}%`, `--dz:${s.dz ?? 8}`, `--r:${s.r ?? 0}deg`, `--d:${i}`].join(';');
// 3 bài báo mới nhất (cuối danh sách là mới nhất).
const latest = press.slice(-3).reverse();
---
<Base lang={lang} page="home" title={t.meta.home.title} description={t.meta.home.description}>
  <!-- HERO: sân khấu sản phẩm -->
  <div class="hero stg" data-stage>
    <div class="stg-giant" aria-hidden="true">
      {h.hero.lines.map((l, i) => <div class:list={['g', { on: i === 0 }]} data-i={i}><span>{l.giant[0]}</span><span>{l.giant[1]}</span></div>)}
    </div>
    <div class="wrap stg-grid">
      <div class="stg-copy">
        <span class="eyebrow light reveal">{h.hero.eyebrow}</span>
        <h1 class="reveal d1" set:html={rich(h.hero.title)} />
        <p class="sub reveal d2">{h.hero.sub}</p>
        <div class="hero-cta reveal d3">
          <Btn href={href('solutions', lang)} arrow>{h.hero.cta1}</Btn>
          <Btn href={href('impact', lang)} variant="glass">{h.hero.cta2}</Btn>
        </div>
      </div>
      <div class="stg-stage reveal d2">
        <div class="stg-view" data-tilt>
        <div class="stg-floor" aria-hidden="true"></div>
        <div class="stg-ring" aria-hidden="true"></div>
        {STAGE.map((st, i) => (
          <div class:list={['stg-slide', { on: i === 0 }]} id={`stg-${i}`} role="tabpanel" data-i={i} aria-label={h.hero.lines[i].name}>
            {st.shots.map((sh, j) => (
              <img src={bot(sh.src)} alt={j === st.shots.length - 1 ? h.hero.lines[i].name : ''} style={shotStyle(sh, j)} decoding="async" fetchpriority={i === 0 ? 'high' : 'low'} />
            ))}
          </div>
        ))}
        </div>
        <div class="stg-spec">
          {h.hero.lines.map((l, i) => (
            <div class="spec" data-i={i} hidden={i !== 0}>
              <div class="k">{String(i + 1).padStart(2, '0')} / {String(STAGE.length).padStart(2, '0')} · {l.kind}</div>
              <div class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              <h2 class="nm">{l.name}</h2>
              <p>{l.desc}</p>
              <ul>{l.tags.map((tg) => <li>{tg}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="wrap stg-bar">
      <div class="stg-pick" role="tablist" aria-label={h.hero.pickLabel}>
        {STAGE.map((st, i) => (
          <button type="button" role="tab" class:list={{ on: i === 0 }} id={`stg-tab-${i}`} aria-controls={`stg-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-pick={i}>
            <span class="th"><img src={bot(st.thumb)} alt="" loading="lazy" decoding="async" /></span>
            <span class="tl">{h.hero.lines[i].tab}</span>
            <i class="prog" aria-hidden="true"></i>
          </button>
        ))}
      </div>
      <button class="stg-toggle" type="button" data-stage-toggle aria-pressed="false" aria-label={t.common.pauseMotion} data-pause={t.common.pauseMotion} data-play={t.common.playMotion}><Icon name="pause" class="i-pause" stroke={2.4} /><Icon name="play" class="i-play" /></button>
    </div>
    <svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" fill="currentColor" aria-hidden="true"><path d="M0 90h1440V40c-220 40-520 50-760 28C420 44 180 20 0 52z"/></svg>
  </div>

  <!-- STATS -->
  <section class="wrap" data-buddy="handsup" aria-label={lang === 'vi' ? 'Số liệu nổi bật' : 'Key figures'}>
    <Stats lang={lang} items={h.stats} class="stats-home" />
    <LogoStrip label={h.partnersStrip} lang={lang} />
  </section>

  <!-- INTRO -->
  <section class="sp has-peek" data-buddy="walk">
    <Peek src="ukit-penguin" class="pk-intro" />
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">{h.intro.eyebrow}</span>
        <h2 class="intro-title" set:html={rich(h.intro.title)} />
      </div>
      <div class="reveal d2 about-body">
        {h.intro.body.map((p) => <p set:html={p} />)}
        <Btn href={href('about', lang)} variant="ghost" arrow>{h.intro.cta}</Btn>
      </div>
    </div>
  </section>

  <!-- 3 THẾ MẠNH -->
  <section class="sp bg-soft has-peek" data-buddy="front">
    <Peek src="ugot-car" class="pk-rs" />
    <div class="wrap">
      <SectionHead eyebrow={h.strengths.eyebrow} title={h.strengths.title} />
      <div class="rs-grid">
        {h.strengths.items.map((it, i) => (
          <div class:list={['rs reveal', `d${i + 1}`]}>
            <div class="tag">{h.strengths.tagPrefix} {String(i + 1).padStart(2, '0')}</div>
            <div class="ic"><Icon name={it.icon} /></div>
            <h3>{it.title}</h3>
            <p>{it.desc}</p>
            {it.ordered
              ? <ol>{it.list.map((li) => <li>{li}</li>)}</ol>
              : <ul>{it.list.map((li) => <li>{li}</li>)}</ul>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HỆ SINH THÁI SẢN PHẨM -->
  <Ecosystem lang={lang} />

  <!-- GIẢI PHÁP -->
  <section class="sp has-peek" data-buddy="walk">
    <Peek src="yanshee-2" class="pk-sol" />
    <div class="wrap">
      <SectionHead eyebrow={h.solPreview.eyebrow} title={h.solPreview.title} lead={h.solPreview.lead} />
      <div class="sol-grid">
        {h.solPreview.items.map((s, i) => <SolCard imgKey={s.img} num={s.num} icon={s.icon} title={s.title} desc={s.desc} index={i} />)}
      </div>
      <div class="center" style="margin-top:42px"><Btn href={href('solutions', lang)} arrow>{h.solPreview.cta}</Btn></div>
    </div>
  </section>

  <!-- VIDEO -->
  {featuredVideo && (
    <section class="sp bg-soft">
      <div class="wrap">
        <SectionHead eyebrow={h.videos.eyebrow} title={h.videos.title} lead={h.videos.lead} />
        <div class="reveal"><InlineVideo item={featuredVideo} lang={lang} playLabel={t.news.video.play} class="iv-feature" /></div>
        <ShortsRail items={shorts} lang={lang} playLabel={t.news.video.play} title={h.videos.shortsTitle} />
        <div class="center vid-more reveal"><Btn href={`${href('news', lang)}#video`} variant="ghost" arrow>{h.videos.cta}</Btn></div>
      </div>
    </section>
  )}

  <!-- NĂNG LỰC HỌC SINH -->
  <section class="sp dark">
    <HexBg tall />
    <div class="wrap">
      <SectionHead title={t.portrait.title} lead={t.portrait.lead} />
      <div class="pgrid">
        {t.portrait.items.map((p, i) => (
          <div class:list={['pcard reveal', `d${(i % 4) + 1}`]}><div class="ic"><Icon name={p.icon} /></div><h3>{p.title}</h3></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GIẢI THƯỞNG -->
  <section class="sp bg-soft has-peek" data-buddy="jump">
    <Peek src="ukit-transformer" class="pk-aw" />
    <div class="wrap">
      <SectionHead eyebrow={h.awardsTeaser.eyebrow} title={h.awardsTeaser.title} />
      <div class="g4 grid" style="margin-bottom:46px">
        {t.awards.map((a, i) => (
          <div class:list={['card award-card reveal', `d${i + 1}`]}>
            <div class="medal"><Icon name={a.icon} /></div>
            <div class="lbl">{a.label}</div>
            <h3>{a.title}</h3><p>{a.short}</p>
          </div>
        ))}
      </div>
      <div class="center reveal"><Btn href={href('impact', lang)} variant="ghost" arrow>{h.awardsTeaser.cta}</Btn></div>
    </div>
  </section>

  <!-- TIN MỚI -->
  {latest.length > 0 && (
    <section class="sp">
      <div class="wrap">
        <SectionHead eyebrow={h.latest.eyebrow} title={h.latest.title} />
        <div class="g3 grid">
          {latest.map((it, i) => <NewsCard item={it} lang={lang} index={i} fallback={t.news.sourceFallback} readLabel={t.news.readOriginal} />)}
        </div>
        <div class="center" style="margin-top:42px"><Btn href={href('news', lang)} variant="ghost" arrow>{h.latest.cta}</Btn></div>
      </div>
    </section>
  )}

  <CtaBand eyebrow={h.cta.eyebrow} title={h.cta.title} lead={h.cta.lead}>
    <Btn href={href('contact', lang)} arrow>{t.common.ctaPartner}</Btn>
    <Btn href={`tel:${SITE.phone}`} variant="glass" icon="phone">{t.common.call}: {SITE.phoneDisplay}</Btn>
  </CtaBand>
</Base>
