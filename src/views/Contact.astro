---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import HexBg from '../components/HexBg.astro';
import { useT } from '../i18n';
import { withBase, type Lang } from '../i18n/routes';
import { SITE } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const c = t.contact;
const phone = lang === 'vi' ? SITE.phoneDisplay : `+84 ${SITE.phoneDisplay.slice(1)}`;
const mail = (subject: string) => `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;
const quick = [
  { icon: 'phone', href: `tel:${SITE.phone}`, val: phone, ...c.quick.call },
  ...(SITE.social.zalo ? [{ icon: 'chat', href: SITE.social.zalo, val: SITE.phoneDisplay, ext: true, ...c.quick.zalo }] : []),
  { icon: 'mail', href: mail(c.quick.emailSubject), val: SITE.email, ...c.quick.email },
  { icon: 'download', href: SITE.profilePdf ? withBase(SITE.profilePdf) : mail(c.quick.profileSubject), val: SITE.profilePdf ? 'PDF' : SITE.email, ...c.quick.profile },
];
const address = lang === 'vi' ? SITE.address : SITE.addressEn;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(SITE.mapQuery)}&hl=${lang}&z=16&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.mapQuery)}`;
---
<Base lang={lang} page="contact" title={t.meta.contact.title} description={t.meta.contact.description}>
  <PageHero lang={lang} title={c.hero.title} lead={c.hero.lead} crumb={t.common.nav.contact} bots={['am-bow']} />

  <section class="sp">
    <div class="wrap">
      <SectionHead eyebrow={c.quick.eyebrow} title={c.quick.title} />
      <div class="quick-grid">
        {quick.map((q, i) => (
          <a class:list={['qc reveal', `d${i + 1}`]} href={q.href} {...('ext' in q ? { target: '_blank', rel: 'noopener' } : {})}>
            <div class="ic"><Icon name={q.icon} /></div>
            <h3>{q.title}</h3>
            <div class="val">{q.val}</div>
            <p>{q.desc}</p>
            <span class="go">{q.title}<Icon name="arrow" stroke={2.4} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sp dark">
    <HexBg tall />
    <div class="wrap">
      <div class="ct-grid">
        <div class="reveal">
          <span class="eyebrow light">{c.info.eyebrow}</span>
          <h2 style="font-size:clamp(24px,3.2vw,34px);margin-top:14px">{lang === 'vi' ? SITE.legalName : SITE.legalNameEn}</h2>
          <div class="ct-info">
            <div class="ct-item"><div class="ic"><Icon name="pin" /></div><div><div class="k">{c.info.address}</div><a class="v" href={mapLink} target="_blank" rel="noopener">{address}</a></div></div>
            <div class="ct-item"><div class="ic"><Icon name="phone" /></div><div><div class="k">{c.info.hotline}</div><a class="v" href={`tel:${SITE.phone}`}>{phone}</a></div></div>
            <div class="ct-item"><div class="ic"><Icon name="mail" /></div><div><div class="k">{c.info.email}</div><a class="v" href={`mailto:${SITE.email}`}>{SITE.email}</a></div></div>
            <div class="ct-item"><div class="ic"><Icon name="globe" /></div><div><div class="k">{c.info.website}</div><span class="v">{SITE.website}</span></div></div>
            <div class="ct-item"><div class="ic"><Icon name="idcard" /></div><div><div class="k">{c.info.taxId}</div><span class="v">{SITE.taxId}</span></div></div>
          </div>
        </div>
        <div class="reveal d2">
          <div class="map-card">
            <iframe src={mapEmbed} title={c.map.title} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            <div class="map-bar"><span>{c.map.title}</span><a href={mapLink} target="_blank" rel="noopener">{c.map.open}<Icon name="external" /></a></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
