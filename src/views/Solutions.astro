---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import SolCard from '../components/SolCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { useT, rich } from '../i18n';
import { href, withBase, type Lang } from '../i18n/routes';
import { img, bot } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const s = t.solutionsPage;
const labPhoto = img('lab-photo');
const se = s.stickem;
---
<Base lang={lang} page="solutions" title={t.meta.solutions.title} description={t.meta.solutions.description}>
  <PageHero lang={lang} title={s.hero.title} lead={s.hero.lead} crumb={t.common.nav.solutions} bots={['tienkung', 'ugot-up']}>
    <Btn href={href('contact', lang)} variant="glass" arrow>{s.hero.cta}</Btn>
  </PageHero>

  <!-- 8 GIẢI PHÁP (thứ tự CEO chốt 07/11/2026; mỗi thẻ dẫn tới section của nó) -->
  <section class="sp">
    <div class="wrap">
      <h2 class="sr-only">{t.common.srSolutions}</h2>
      <div class="sol-grid g4">
        {t.solutions.map((x, i) => <SolCard imgKey={x.id} num={x.num} icon={x.icon} title={x.title} desc={x.desc} tag={x.tag} index={i} href={x.hash} />)}
      </div>
    </div>
  </section>

  <!-- PHÒNG STEM – AI LAB -->
  <section class="sp lab" id="lab">
    <div class="glow"></div>
    <div class="wrap">
      <div class="lab-grid">
        <div class="reveal">
          <span class="eyebrow">{s.lab.eyebrow}</span>
          <h2>{s.lab.title}</h2>
          <p class="lead" set:html={s.lab.lead} />
          <div class="lab-chips">{s.lab.chips.map((c) => <span class="chip">{c}</span>)}</div>
          <div class="lab-feats">
            {s.lab.feats.map((f) => (
              <div class="feat"><div class="ic"><Icon name={f.icon} /></div><div><h3>{f.title}</h3><p>{f.desc}</p></div></div>
            ))}
          </div>
        </div>
        <div class="reveal d2">
          <div class="op-card">
            <div class="op-photo">
              {labPhoto
                ? <img src={labPhoto} alt={s.lab.photoLabel} loading="lazy" decoding="async" />
                : <>
                    <svg class="ph-hex" width="88" height="88" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M50 8 84 28v44L50 92 16 72V28z"/><circle cx="50" cy="50" r="13"/></svg>
                    <span class="ph-label"><Icon name="camera" />{s.lab.photoLabel}</span>
                  </>}
            </div>
            <h4>{s.lab.opTitle}</h4>
            <div class="op-stats">
              {s.lab.opStats.map((o) => <div class="op-stat"><div class="v">{o.v} <span>{o.u}</span></div><div class="k">{o.k}</div></div>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section dạng chung: ảnh một bên, thẻ một bên, đổi bên xen kẽ. */}
  {[s.blocks.phtm, s.blocks.ailab].map((b, i) => (
    <section class:list={['sp blk', { 'bg-soft': i % 2 === 0 }]} id={b.id}>
      <div class:list={['wrap split mid', { rev: i % 2 === 1 }]}>
        <div class="blk-ph reveal">{img(b.img) && <img src={img(b.img)} alt="" loading="lazy" decoding="async" />}</div>
        <div class="reveal d2">
          <span class="eyebrow">{b.eyebrow}</span>
          <h2 class="fd blk-t" set:html={rich(b.title)} />
          <p class="lead">{b.lead}</p>
          <div class="grid g2 blk-cards">
            {b.cards.map((c) => <div class="card"><div class="ic-box"><Icon name={c.icon} /></div><h3>{c.title}</h3><p>{c.desc}</p></div>)}
          </div>
          
        </div>
      </div>
    </section>
  ))}

  <!-- LỘ TRÌNH K12 -->
  <section class="sp" id="k12">
    <div class="wrap">
      <SectionHead eyebrow={s.ladder.eyebrow} title={s.ladder.title} lead={s.ladder.lead} />
      <div class="prog-grid">
        {s.ladder.steps.map((st, i) => (
          <div class:list={['step reveal', `d${i + 1}`]}>
            <div class="dot"><Icon name={st.icon} stroke={1.8} /></div>
            <span class="age">{st.age}</span>
            <h3>{st.title}</h3>
            <p>{st.desc}</p>
            <span class="pill">{st.pill}</span>
          </div>
        ))}
      </div>
      <div class="prog-note reveal"><span>{s.ladder.noteLabel}</span>{s.ladder.notePills.map((p) => <span class="pill">{p}</span>)}</div>
    </div>
  </section>

  <!-- STICK 'EM -->
  <section class="sp se-sec" id="stick-em">
    <div class="wrap">
      <div class="se-grid">
        <div class="reveal">
          <img class="se-logo" src={withBase('/images/stickem/logo.webp')} alt="Stick 'Em" width="400" height="364" loading="lazy" decoding="async" />
          <span class="eyebrow">{se.eyebrow}</span>
          <h2 class="fd" set:html={rich(se.title)} />
          <p class="lead">{se.lead}</p>
          <div class="se-feats">
            {se.feats.map((f) => <div class="se-feat"><div class="ic"><Icon name={f.icon} /></div><div><h3>{f.title}</h3><p>{f.desc}</p></div></div>)}
          </div>
        </div>
        <div class="se-art reveal d2" aria-hidden="true">
          <img class="kit" src={bot('stickem-kit')} alt="" loading="lazy" decoding="async" />
          <img class="board" src={withBase('/images/stickem/board.webp')} alt="" loading="lazy" decoding="async" />
          <img class="st st1" src={withBase('/images/stickem/sticky-trophy.webp')} alt="" loading="lazy" decoding="async" />
          <img class="st st2" src={withBase('/images/stickem/sticky-selfie.webp')} alt="" loading="lazy" decoding="async" />
          <img class="st st3" src={withBase('/images/stickem/sticky-racer.webp')} alt="" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="se-photos">
        {se.photos.map((ph, i) => <figure class:list={['reveal', `d${i + 1}`]}><img src={withBase(ph.src)} alt={ph.alt} loading="lazy" decoding="async" /><figcaption>{ph.alt}</figcaption></figure>)}
      </div>
    </div>
  </section>

  {/* Section dạng chung: ảnh một bên, thẻ một bên, đổi bên xen kẽ. */}
  {[s.blocks.sanChoi, s.blocks.tourHe, s.blocks.huanLuyen, s.blocks.ihub].map((b, i) => (
    <section class:list={['sp blk', { 'bg-soft': i % 2 === 1 }]} id={b.id}>
      <div class:list={['wrap split mid', { rev: i % 2 === 1 }]}>
        <div class="blk-ph reveal">{img(b.img) && <img src={img(b.img)} alt="" loading="lazy" decoding="async" />}</div>
        <div class="reveal d2">
          <span class="eyebrow">{b.eyebrow}</span>
          <h2 class="fd blk-t" set:html={rich(b.title)} />
          <p class="lead">{b.lead}</p>
          <div class="grid g2 blk-cards">
            {b.cards.map((c) => <div class="card"><div class="ic-box"><Icon name={c.icon} /></div><h3>{c.title}</h3><p>{c.desc}</p></div>)}
          </div>
          {b.id === 'san-choi' && <div class="blk-promo"><p><b>{s.promo.title}</b> {s.promo.desc}</p><Btn href={href('contact', lang)} size="sm" arrow>{s.promo.cta}</Btn></div>}
        </div>
      </div>
    </section>
  ))}

  <CtaBand title={s.cta.title} lead={s.cta.lead}>
    <Btn href={href('contact', lang)} arrow>{s.cta.primary}</Btn>
    <Btn href={href('partnership', lang)} variant="glass">{s.cta.secondary}</Btn>
  </CtaBand>
</Base>
