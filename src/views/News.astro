---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import BlogCard from '../components/BlogCard.astro';
import VideoCard from '../components/VideoCard.astro';
import ShortsRail from '../components/ShortsRail.astro';
import CtaBand from '../components/CtaBand.astro';
import { useT } from '../i18n';
import { href, withBase, type Lang } from '../i18n/routes';
import { videos, shorts, photos, titleOf } from '../data/media';
import { getPosts, postHref, readMinutes, fmtDate, type Category } from '../data/blog';

// Trang Blog (khoá trang 'news'): bài tự viết của Learn to Leap + video, ảnh hoạt động.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const n = t.news;
const b = n.blog;
const posts = await getPosts(lang);
const [feat, ...rest] = posts;
const cats = Object.keys(b.cats) as Category[];
const usedCats = cats.filter((c) => posts.some((p) => p.data.category === c));
const hasSample = posts.some((p) => p.data.sample);
const vids = [...videos].reverse();
---
<Base lang={lang} page="news" title={t.meta.news.title} description={t.meta.news.description} lightbox>
  <PageHero lang={lang} title={n.hero.title} lead={n.hero.lead} crumb={t.common.nav.news} bots={['cruzr', 'am-walk']} />

  <section class="sp">
    <div class="wrap">
      {hasSample && <p class="blog-note reveal"><Icon name="idea" />{b.sampleNote}</p>}

      {feat && (
        <a class="blog-feat reveal" href={postHref(feat)}>
          <div class="bf-media">
            <img src={withBase(feat.data.cover)} alt="" decoding="async" />
            {feat.data.sample && <span class="bc-sample">{b.sample}</span>}
          </div>
          <div class="bf-body">
            <span class="bf-lbl">{b.featured} · {b.cats[feat.data.category]}</span>
            <h2>{feat.data.title}</h2>
            <p>{feat.data.excerpt}</p>
            <span class="bf-meta"><Icon name="calendar" />{fmtDate(feat.data.date, lang)}<span aria-hidden="true">·</span>{readMinutes(feat)} {b.minutes}</span>
            <span class="bf-go">{b.read}<Icon name="arrow" stroke={2.4} /></span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="tl-sec" id="bai-viet">
          <div class="blog-top">
            <SectionHead eyebrow={b.eyebrow} title={b.title} />
            {usedCats.length > 1 && (
              <div class="blog-filter reveal" role="group" aria-label={b.filterLabel} data-blog-filter>
                <button type="button" class="on" data-cat="" aria-pressed="true">{b.all}</button>
                {usedCats.map((c) => <button type="button" data-cat={c} aria-pressed="false">{b.cats[c]}</button>)}
              </div>
            )}
          </div>
          <div class="g3 grid blog-grid" data-blog-grid>
            {rest.map((p, i) => <BlogCard post={p} lang={lang} index={i} />)}
          </div>
          <p class="tl-state" data-blog-empty hidden>{b.empty}</p>
        </div>
      )}

      {!posts.length && <p class="tl-state">{b.empty}</p>}

      {shorts.length > 0 && (
        <div class="tl-sec" id="video-ngan">
          <SectionHead eyebrow={n.shorts.eyebrow} title={n.shorts.title} />
          <ShortsRail items={shorts} lang={lang} playLabel={n.video.play} />
        </div>
      )}

      {vids.length > 0 && (
        <div class="tl-sec" id="video">
          <SectionHead eyebrow={n.video.eyebrow} title={n.video.title} />
          <div class="vid-grid featured">
            {vids.map((it, i) => <VideoCard item={it} lang={lang} index={i} playLabel={n.video.play} />)}
          </div>
        </div>
      )}

      {photos.length > 0 && (
        <div class="tl-sec" id="hinh-anh">
          <SectionHead eyebrow={n.photos.eyebrow} title={n.photos.title} />
          <div class="gal-grid">
            {photos.map((p) => {
              const title = titleOf(p, lang);
              return <button class="gcell" type="button" data-photo={p.image} data-title={title} aria-label={title}><img src={p.image} alt={title} loading="lazy" decoding="async" /></button>;
            })}
          </div>
        </div>
      )}
    </div>
  </section>

  <CtaBand title={n.cta.title} lead={n.cta.lead}>
    <Btn href={href('contact', lang)} arrow>{n.cta.primary}</Btn>
  </CtaBand>
</Base>
