---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { useT } from '../i18n';
import { href, type Lang } from '../i18n/routes';
import { bot } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const p = t.products;
---
<Base lang={lang} page="products" title={t.meta.products.title} description={t.meta.products.description}>
  <PageHero lang={lang} title={p.hero.title} lead={p.hero.lead} crumb={t.common.nav.products} bots={['yanshee', 'ugot-up']}>
    <Btn href={href('store', lang)} variant="glass" arrow>{p.hero.cta}</Btn>
  </PageHero>

  {p.groups.map((g, i) => (
    <section class:list={['sp', { 'bg-soft': i % 2 === 1 }]} id={g.id}>
      <div class:list={['wrap split mid', { rev: i % 2 === 1 }]}>
        <div class="pr-art blk-ph reveal" aria-hidden="true">
          {g.bots.map((b, j) => <img class={`pr-${j}`} src={bot(b)} alt="" loading="lazy" decoding="async" />)}
        </div>
        <div class="reveal d2">
          <span class="eyebrow">{g.kind}</span>
          <h2 class="fd blk-t">{g.name}</h2>
          <p class="lead">{g.desc}</p>
          <dl class="pr-meta">
            <dt>{p.levelLabel}</dt><dd>{g.level}</dd>
            <dt>{p.usesLabel}</dt><dd><ul>{g.uses.map((u) => <li>{u}</li>)}</ul></dd>
          </dl>
          <Btn href={href('store', lang) + g.store} variant="ghost" arrow>{p.storeCta}</Btn>
        </div>
      </div>
    </section>
  ))}

  <CtaBand title={t.solutionsPage.cta.title} lead={t.solutionsPage.cta.lead}>
    <Btn href={href('contact', lang)} arrow>{t.solutionsPage.cta.primary}</Btn>
    <Btn href={href('store', lang)} variant="glass">{p.storeCta}</Btn>
  </CtaBand>
</Base>
